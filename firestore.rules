rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerAdmin() {
      return isVerifiedUser()
        && (
          request.auth.token.email == 'george1tragas@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isSafeHttpUrl(val) {
      return val is string
        && val.size() >= 1
        && val.size() <= 1000
        && val.matches('^https?://.+');
    }

    function isValidMediaSrc(val) {
      return val is string
        && val.size() >= 1
        && val.size() <= 600000
        && (
          val.matches('^/[^/][a-zA-Z0-9_\\-./]*$')
          || val.matches('^https?://.+')
          || val.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+$')
        );
    }

    // --- Entity Validators ---
    function isValidProject(data) {
      return data.keys().hasAll(['title', 'year', 'category', 'url', 'featured', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'year', 'category', 'url', 'description', 'imageUrl', 'featured', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.year is string && data.year.matches('^[0-9]{4}$')
        && data.category in ['web-app', 'extension', 'website', 'finance', 'negotiations', 'real-estate', 'other']
        && isSafeHttpUrl(data.url)
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('imageUrl' in data) || data.imageUrl == '' || isValidMediaSrc(data.imageUrl))
        && data.featured is bool
        && (data.sortOrder is int || data.sortOrder is float)
        && data.ownerUid is string && data.ownerUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLink(data) {
      return data.keys().hasAll(['label', 'group', 'url', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['label', 'group', 'url', 'imageUrl', 'description', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.group in ['social', 'channel', 'resource']
        && isSafeHttpUrl(data.url)
        && (!('imageUrl' in data) || data.imageUrl == '' || isValidMediaSrc(data.imageUrl))
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && (data.sortOrder is int || data.sortOrder is float)
        && data.ownerUid is string && data.ownerUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['title', 'category', 'src', 'alt', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'category', 'src', 'alt', 'linkUrl', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.category in ['social-marketing', 'project-preview', 'analytics', 'other']
        && isValidMediaSrc(data.src)
        && data.alt is string && data.alt.size() >= 1 && data.alt.size() <= 200
        && (!('linkUrl' in data) || data.linkUrl == '' || isSafeHttpUrl(data.linkUrl))
        && (data.sortOrder is int || data.sortOrder is float)
        && data.ownerUid is string && data.ownerUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'location', 'headline', 'subheadline', 'heroImage', 'resumeUrl', 'assessmentUrl', 'ownerUid', 'updatedAt'])
        && data.keys().hasOnly(['name', 'location', 'headline', 'subheadline', 'heroImage', 'heroCaption', 'resumeUrl', 'assessmentUrl', 'ownerUid', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 120
        && data.headline is string && data.headline.size() >= 1 && data.headline.size() <= 200
        && data.subheadline is string && data.subheadline.size() >= 1 && data.subheadline.size() <= 400
        && isValidMediaSrc(data.heroImage)
        && (!('heroCaption' in data) || (data.heroCaption is string && data.heroCaption.size() <= 300))
        && isSafeHttpUrl(data.resumeUrl)
        && isSafeHttpUrl(data.assessmentUrl)
        && data.ownerUid is string && data.ownerUid == request.auth.uid
        && data.updatedAt is timestamp;
    }

    // --- Connection Check Document ---
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // --- Admin Registry (read own record only; never client-writable) ---
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // --- Portfolio Projects ---
    match /projects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isOwnerAdmin();
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'year', 'category', 'url', 'description', 'imageUrl', 'featured', 'sortOrder', 'updatedAt'])
        && isOwnerAdmin();
      allow delete: if isVerifiedUser() && isValidId(projectId) && isOwnerAdmin();
    }

    // --- Portfolio Links ---
    match /links/{linkId} {
      allow get: if isValidId(linkId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(linkId)
        && isValidLink(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isOwnerAdmin();
      allow update: if isVerifiedUser()
        && isValidId(linkId)
        && isValidLink(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'group', 'url', 'imageUrl', 'description', 'sortOrder', 'updatedAt'])
        && isOwnerAdmin();
      allow delete: if isVerifiedUser() && isValidId(linkId) && isOwnerAdmin();
    }

    // --- Portfolio Media ---
    match /media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if true;
      allow create: if isVerifiedUser()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isOwnerAdmin();
      allow update: if isVerifiedUser()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'src', 'alt', 'linkUrl', 'sortOrder', 'updatedAt'])
        && isOwnerAdmin();
      allow delete: if isVerifiedUser() && isValidId(mediaId) && isOwnerAdmin();
    }

    // --- Portfolio Profile Config ---
    match /profile/{profileId} {
      allow get: if profileId == 'main';
      allow list: if true;
      allow create: if isVerifiedUser()
        && profileId == 'main'
        && isValidProfile(incoming())
        && incoming().updatedAt == request.time
        && isOwnerAdmin();
      allow update: if isVerifiedUser()
        && profileId == 'main'
        && isValidProfile(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'headline', 'subheadline', 'heroImage', 'heroCaption', 'resumeUrl', 'assessmentUrl', 'updatedAt'])
        && isOwnerAdmin();
      allow delete: if false;
    }
  }
}
